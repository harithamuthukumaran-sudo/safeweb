# ============================================================
# SafeWeb — Root .gitignore
# ============================================================

# ── Secrets (NEVER commit these) ───────────────────────────
**/.env
**/.env.local
**/.env.production
**/.env.staging
!**/.env.example          # keep the template, ignore the real file

# ── Python / Backend ───────────────────────────────────────
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/.pytest_cache/
backend/.ruff_cache/
*.egg-info/
dist/
build/
.eggs/

# ── Node / Frontend ────────────────────────────────────────
frontend-web/node_modules/
frontend-web/dist/
frontend-web/.vercel/

# ── Mobile ─────────────────────────────────────────────────
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/android/
mobile/ios/
mobile/.easignore

# ── OS / Editor ────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/settings.json
.idea/

# ── Logs ───────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
