# Frontend environment variables (SAFE to commit – these are public Supabase keys)
# See: https://supabase.com/docs/guides/api/api-keys

# Your Supabase project URL (from: Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous / public key (safe for browser – protected by RLS)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Your FastAPI backend URL (local dev)
VITE_API_URL=http://127.0.0.1:8000
