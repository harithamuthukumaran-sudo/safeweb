# ============================================================
# SafeWeb Backend — Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to version control
# ============================================================

# ─── Application ────────────────────────────────────────────
PROJECT_NAME=SafeWeb API
VERSION=1.0.0
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# ─── CORS ───────────────────────────────────────────────────
# Add your frontend URL here (comma-separated for multiple)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Supabase ───────────────────────────────────────────────
# From: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co

# "anon" public key — used only as fallback, not in backend logic
SUPABASE_ANON_KEY=your-supabase-anon-key

# "service_role" secret key — allows backend to bypass RLS
# KEEP THIS SECRET. Never put this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT secret — from: Supabase Dashboard → Project Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── Threat Intelligence APIs ───────────────────────────────
# Google Safe Browsing v4
# Get key: https://console.cloud.google.com → APIs → Safe Browsing API
GOOGLE_SAFE_BROWSING_API_KEY=your-google-safe-browsing-key

# VirusTotal v3 Public API
# Get key: https://www.virustotal.com/gui/my-apikey (free account)
VIRUSTOTAL_API_KEY=your-virustotal-api-key

# ─── Security Limits (safe defaults, adjust if needed) ──────
CONNECT_TIMEOUT_SECONDS=3.0
TOTAL_TIMEOUT_SECONDS=5.0
MAX_RESPONSE_BYTES=524288
MAX_REDIRECT_HOPS=3
